# Discourse's web container, written by vekn-forum/deploy: every site of the multisite, its database
# in the `data` container. A change here bootstraps a new image while this one serves, then swaps.
templates:
  - "templates/web.template.yml"
  # host nginx terminates TLS and proxies to /shared/nginx.http.sock: no published port, which
  # Docker would open past UFW
  - "templates/web.socketed.template.yml"

links:
  - link:
      name: data
      alias: data

params:
  version: {{ ref }}

env:
  LC_ALL: en_US.UTF-8
  LANG: en_US.UTF-8
  LANGUAGE: en_US.UTF-8
  UNICORN_WORKERS: 4
  DISCOURSE_HOSTNAME: "{{ default_domain }}"
  DISCOURSE_DEVELOPER_EMAILS: "{{ developer_emails }}"
  DISCOURSE_DB_SOCKET: ""
  DISCOURSE_DB_HOST: data
  DISCOURSE_DB_PASSWORD: "{{ db_password }}"
  DISCOURSE_REDIS_HOST: data
  DISCOURSE_SMTP_ADDRESS: smtp.gmail.com
  DISCOURSE_SMTP_PORT: 587
  DISCOURSE_SMTP_USER_NAME: "{{ mail }}"
  DISCOURSE_SMTP_PASSWORD: "{{ mail_password }}"
  DISCOURSE_SMTP_ENABLE_START_TLS: true
  # the bridge's sweep reads and writes every member through the admin API, from this host's own
  # address: exempt from the per-IP limits, which count every site of the multisite together. The
  # launcher's nginx rate limit (web.ratelimited) has no exemption, so it is left out.
  DISCOURSE_MAX_ADMIN_API_REQS_PER_MINUTE: 6000
  DISCOURSE_MAX_REQS_PER_IP_EXCEPTIONS: "{{ host_ip }}"

volumes:
  - volume:
      host: {{ web_dir }}
      guest: /shared
  - volume:
      host: {{ web_dir }}/log/var-log
      guest: /var/log

hooks:
  before_bundle_exec:
    - file:
        path: $home/config/multisite.yml
        contents: |
{% for site in extra_sites %}
          {{ site.db }}:
            adapter: postgresql
            database: discourse_{{ site.db }}
            host: data
            username: discourse
            password: "{{ db_password }}"
            pool: 25
            timeout: 5000
            host_names:
              - {{ site.domain }}
{% endfor %}
  after_bundle_exec:
    - exec: cd /var/www/discourse && sudo -E -u discourse bundle exec rake multisite:migrate
